---
import { sponsorPitch, sponsors, sponsorTiers } from "../data/event";
import { wordmarkSvg } from "../lib/art";
---

<section id="sponsors" class="section sponsors" aria-labelledby="sponsors-title">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Sponsors</span>
      <h2 id="sponsors-title">Made possible by</h2>
    </div>
    {sponsorTiers.map((tier) => {
      const list = sponsors.filter((s) => s.tier === tier.id);
      if (!list.length) return null;
      return (
        <div class={`tier tier-${tier.id}`}>
          <h3>{tier.name}</h3>
          <ul>
            {list.map((s) => (
              <li>
                <a href={s.href} rel="noopener sponsored" aria-label={s.name}>
                  {s.logo ? <img src={s.logo} alt={`${s.name} logo`} loading="lazy" /> : <Fragment set:html={wordmarkSvg(s.name)} />}
                </a>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
    <div class="pitch">
      <div>
        <h3>{sponsorPitch.title}</h3>
        <p>{sponsorPitch.text}</p>
      </div>
      <a class="btn btn-ghost" href={`mailto:${sponsorPitch.email}?subject=Sponsorship`}>Become a sponsor</a>
    </div>
  </div>
</section>

<style>
  .sponsors {
    background: var(--bg-raised);
    border-block: 1px solid var(--line);
  }
  .tier + .tier {
    margin-top: 2.5rem;
  }
  h3 {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
    font-weight: 500;
    margin-bottom: 1rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .tier-headline ul {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .tier-gold ul {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }
  .tier-community ul {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
  }
  li a {
    display: grid;
    place-items: center;
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: #e9e9f2;
    padding: 1.5rem 1rem;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  li a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .tier-headline li a {
    padding-block: 2.75rem;
  }
  .tier-headline li a :global(svg) {
    height: 44px;
    width: auto;
  }
  .tier-gold li a :global(svg) {
    height: 34px;
    width: auto;
  }
  .tier-community li a :global(svg) {
    height: 27px;
    width: auto;
  }
  li a img {
    max-height: 44px;
    width: auto;
  }
  @media (max-width: 640px) {
    .tier-headline li a {
      padding-block: 2rem;
    }
    .tier-gold ul,
    .tier-community ul {
      grid-template-columns: repeat(2, 1fr);
    }
    .tier-gold li a :global(svg) {
      height: 26px;
    }
    .tier-community li a :global(svg) {
      height: 22px;
    }
  }
  .pitch {
    margin-top: 3rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  .pitch h3 {
    font-family: var(--font-display);
    text-transform: none;
    letter-spacing: -0.01em;
    color: var(--text);
    font-size: 1.35rem;
    font-weight: 500;
    margin-bottom: 0.3rem;
  }
  .pitch p {
    color: var(--muted);
  }
</style>
