---
import type { Speaker } from "../data/event";
import { avatarSvg } from "../lib/art";

interface Props {
  speaker: Speaker;
  headingLevel?: "h3" | "h2";
}
const { speaker, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
---

<article class="card">
  <div class="avatar" set:html={avatarSvg(speaker.name, `Illustrated portrait placeholder for ${speaker.name}`)} />
  <div class="info">
    <Heading class="name"><a href={`/speakers/${speaker.slug}/`}>{speaker.name}</a></Heading>
    <p class="role">{speaker.role}</p>
    <p class="company">{speaker.company}</p>
  </div>
</article>

<style>
  .card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.16s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .card:hover,
  .card:focus-within {
    border-color: color-mix(in srgb, var(--text) 40%, transparent);
  }
  .avatar :global(svg) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }
  .info {
    padding: 1rem 1.1rem 1.2rem;
  }
  .name {
    font-size: 1.25rem;
  }
  .name a {
    text-decoration: none;
  }
  /* Whole card is clickable through the name link. */
  .name a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .role {
    color: var(--muted);
    font-size: 0.95rem;
    margin-top: 0.35rem;
  }
  .company {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 0.2rem;
  }
</style>
